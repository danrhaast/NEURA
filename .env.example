# Copie para .env.local e preencha rodando: npm run senha

# Assina o cookie de sessão do painel e deriva o identificador diário usado
# na contagem de visitantes únicos. Trocar este valor desloga todo mundo.
SESSAO_SEGREDO=

# Banco. Em desenvolvimento, um arquivo local; em produção, o Turso.
# O Vercel tem disco efêmero: com "file:" lá, tudo que for publicado pelo
# painel some no próximo cold start.
#
#   local       file:data/neura.db          (é o padrão se ficar vazio)
#   produção    libsql://SEU-BANCO.turso.io
#
# Os dois nomes valem: TURSO_DATABASE_URL puro, ou com o prefixo de recurso que
# a integração do Turso no Vercel cria. O par é sempre lido do mesmo prefixo.
ERICBANANA_TURSO_DATABASE_URL=
ERICBANANA_TURSO_AUTH_TOKEN=

# Endereço público do site, sem barra no fim. Usado pelo OpenGraph, pelo
# robots.txt e pelo sitemap. No Vercel pode ficar vazio — o domínio de
# produção é detectado sozinho. Preencha quando o domínio próprio existir.
NEXT_PUBLIC_SITE_URL=

# Fuso do público, para o dashboard agrupar as visitas pelo dia certo — o
# servidor do Vercel roda em UTC. É o nome IANA da zona, não um deslocamento:
# assim o horário de verão é resolvido sozinho. Padrão: America/New_York.
#
#   America/New_York     Leste     ·  America/Chicago      Central
#   America/Denver       Montanha  ·  America/Los_Angeles  Pacífico
#   America/Sao_Paulo    Brasil
SITE_FUSO=

# Opcional. As contas do painel ficam no banco (npm run usuario), não aqui.
# Este campo só serve de atalho para a PRIMEIRA conta: havendo um hash aqui e
# um banco ainda não semeado, o servidor cria "admin" com esta senha. Depois
# disso ele é ignorado e pode ser removido.
ADMIN_SENHA_HASH=
